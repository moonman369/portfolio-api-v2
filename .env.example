# Copy to `.env` and fill in real values. Never commit the real `.env`.
#
# Every variable here is read by src/config.js and nowhere else. Anything marked
# REQUIRED must be set or the process refuses to boot, naming the offender.
#
# Phase 0 scope: the stats endpoints and the HTTP skeleton. Gemini, OpenAI and the
# MoonMind model/retrieval variables arrive with the phases that use them.

# ---- Server ----
# development | test | production
NODE_ENV=production
# Port inside the container. The host mapping (127.0.0.1:8001) lives in
# docker-compose.yml, so this normally stays 8000.
PORT=8000
# Comma-separated allowlist. Unset falls back to the old service's origins, so the
# existing portfolio frontends keep working through cutover.
# CORS_ORIGINS=https://moonman.in,https://new.moonman.in,http://localhost:5173
# REQUEST_BODY_LIMIT=1mb

# ---- MongoDB (Atlas) — REQUIRED ----
# Atlas is required: the MoonMind retrieval subsystem uses $vectorSearch, which a
# self-hosted mongo container does not support out of the box.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
MONGO_DB_NAME=portfolio-stats-api
# The GitHub stats archive. These were hardcoded in the old service; they name a live
# collection and a live document, so keep them pointed at the same place for parity.
MONGO_STATS_COLLECTION=gitStatsArchive
MONGO_STATS_DOC_ID=github_stats
# MONGO_TIMEOUT_MS=10000
# Optional DNS override for the SRV lookup that `mongodb+srv://` performs before it can
# reach Atlas. Set this if startup fails with `querySrv ECONNREFUSED` — that is the
# resolver refusing SRV queries, not a credential or IP-allowlist problem. Common on
# machines behind a local DNS stub, a VPN, or a corporate resolver.
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- GitHub stats refresh — REQUIRED ----
# Classic or fine-grained PAT with read access to the profile's repositories.
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxx
REFRESH_PROFILE=your-github-username
# Guards GET /api/v1/refresh via the `secret` query parameter. Use a long random
# string — this is the only thing standing in front of an expensive endpoint.
REFRESH_SECRET=change-me-long-random-string
# GITHUB_TIMEOUT_MS=20000
# REFRESH_RATE_LIMIT_WINDOW_MS=900000
# REFRESH_RATE_LIMIT_MAX=5

# ---- LeetCode ----
LEETCODE_USERNAME=moonman369
# LEETCODE_TIMEOUT_MS=15000
# In-process cache TTL, 1 hour by default. Dies with the container.
# LEETCODE_CACHE_TTL_MS=3600000

# ---- OpenAI (chat completions) — REQUIRED ----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Full base URL INCLUDING the version segment. Note this differs from the old
# service, whose adapter appended "/v1" itself.
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- MoonMind chat — REQUIRED ----
# Shared `password` request header for POST /api/v1/moonmind/chat. Same header the
# old service used, so the frontend's auth does not change at cutover.
MOONMIND_PASSWORD=change-me

# Per-role models. Only the two below have defaults; the rest fall back along
# these chains, so you can move one role without touching the others:
#   router    -> MOONMIND_INTENT_MODEL
#   decompose -> MOONMIND_INTENT_MODEL
#   rerank    -> MOONMIND_RESPONSE_MODEL
#   agent     -> MOONMIND_RESPONSE_MODEL
MOONMIND_RESPONSE_MODEL=gpt-4o-mini
MOONMIND_INTENT_MODEL=gpt-4o-mini
# MOONMIND_ROUTER_MODEL=gpt-4o-mini
# MOONMIND_DECOMPOSE_MODEL=gpt-4o-mini
# MOONMIND_RERANK_MODEL=gpt-4o-mini
# MOONMIND_AGENT_MODEL=gpt-4o-mini
# MOONMIND_MODEL_TIMEOUT_MS=60000

# ---- Routing and run limits ----
# Below this router confidence the turn is redirected to about_me. This is also
# what keeps a low-confidence guess from ever reaching an action route.
# MOONMIND_ROUTER_MIN_CONFIDENCE=0.5
# A classification this confident into a different route ends a sticky flow.
# MOONMIND_TOPIC_CHANGE_CONFIDENCE=0.8
# MOONMIND_MAX_MESSAGE_CHARS=4000
# How many recent messages are replayed to a model.
# MOONMIND_HISTORY_MAX_MESSAGES=20
# Wall-clock cap for one graph run.
# MOONMIND_RUN_TIMEOUT_MS=120000
# MOONMIND_RECURSION_LIMIT=25
# Model calls one agent node gets per run (tech_web, and the agents in 6b/7). Each
# tool-calling round is one call, so this bounds both cost and latency. Hitting it ends
# the run gracefully with whatever sources were gathered, not with an error.
# MOONMIND_AGENT_MAX_STEPS=4

# ---- Debug tracing ----
# Per-node trace of every run: order, timing, and what each node decided. Covers /chat and
# the run feed alike. Off by default; costs nothing when off.
#   MOONMIND_DEBUG=true node --env-file=.env src/server.js
# MOONMIND_DEBUG=false
# LangChain's own verbosity: every prompt and every completion, in full. Separate because
# the volume is on a different scale - one about_me turn prints ten documents of context.
# Turn it on once MOONMIND_DEBUG has told you which node to look at.
# MOONMIND_DEBUG_MODELS=false
# Scope guard: one cheap classification before an agent dispatches any tool. A blocked
# question costs that call and nothing else - no agent loop, no search credit.
# MOONMIND_SCOPE_GUARD_ENABLED=true
# Extra excluded topics, comma-separated, APPENDED to the built-in list in
# src/agent/prompts.js (EXCLUDED_TOPICS). Use snake_case ids that read as a category,
# e.g. gambling,celebrity_gossip. Editing this needs a container restart, not a rebuild.
# MOONMIND_EXCLUDED_TOPICS=

# ---- Tavily web search - REQUIRED ----
# Powers the `tech_web` route. Chosen over a snippets-only search API because it returns
# extracted page content, so the agent can ground an answer without a scraping layer.
# Free tier is ~1,000 credits/month; "advanced" depth costs 2 credits per search.
# The container will not boot without this key.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx
TAVILY_BASE_URL=https://api.tavily.com
# TAVILY_TIMEOUT_MS=15000
# TAVILY_MAX_RESULTS=5
# TAVILY_SEARCH_DEPTH=basic

# ---- LangGraph checkpointer (conversation state) ----
# MONGO_CHECKPOINT_COLLECTION=moonmind_checkpoints
# MONGO_CHECKPOINT_WRITES_COLLECTION=moonmind_checkpoint_writes

# ---- Live event feed (POST /runs + GET /runs/:id) ----
# Step traces for watching a run, not durable data. Both collections are TTL-indexed,
# so they are dropped once the retention window passes. The viewer is served at
# /run-viewer.html.
# MONGO_RUNS_COLLECTION=moonmind_runs
# MONGO_RUN_STEPS_COLLECTION=moonmind_run_steps
# MOONMIND_RUN_RETENTION_DAYS=7

# ---- Gemini embeddings — REQUIRED ----
# Powers document and query embeddings. Not used for chat completions.
GEMINI_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxx
# Base only — the code appends "/v1beta/models/<model>:embedContent".
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# MUST equal `numDimensions` on the Atlas vector index. The live index is 768;
# changing this without re-embedding makes every write unsearchable.
GEMINI_EMBEDDING_DIMENSIONS=768
# GEMINI_TIMEOUT_MS=30000
# Retry/backoff for 429s and transient 5xx. Honors `Retry-After`.
# GEMINI_MAX_RETRIES=5
# GEMINI_RETRY_BASE_MS=500
# GEMINI_MAX_BACKOFF_MS=20000
# Character budget for the whole embedded text, prefix included. Changing this changes
# what gets truncated, which changes the vectors — leave it alone unless re-embedding.
# GEMINI_MAX_INPUT_CHARS=28000

# ---- Vector collection ----
# All three must match what the existing vectors were written under.
MONGO_VECTOR_COLLECTION=moonmind_documents_v3
MONGO_VECTOR_INDEX=vector_index
MONGO_VECTOR_FIELD=embedding

# ---- Retrieval tuning (all optional; safe defaults shown) ----
# ANN candidates scanned before the vector limit. Higher = better recall.
# MOONMIND_VECTOR_NUM_CANDIDATES=150
# Reciprocal Rank Fusion constant (standard default 60).
# MOONMIND_RRF_K=60
# How many documents reach the answer prompt.
# MOONMIND_FINAL_DOCUMENT_LIMIT=10
# How many candidates each arm fetches before fusion. Keep comfortably above the final
# limit, or ranking has no headroom and ordering stops mattering.
# MOONMIND_RETRIEVAL_CANDIDATE_LIMIT=30
# Per-arm RRF weights: how much each arm decides WHICH DOCUMENTS SURFACE.
# MOONMIND_RRF_WEIGHT_SEMANTIC=1
# MOONMIND_RRF_WEIGHT_KEYWORD=1
# MOONMIND_RRF_WEIGHT_METADATA=0.5
# Per-document boosts added on top of the fused score, i.e. WHICH DOCUMENT WINS.
# Both default to 0 (disabled). RRF compresses hard — the whole retrieval signal spans
# roughly 0.005 across 30 results — so a weight that looks small is not weak. The old
# repo's own docs disagreed on the usable band; re-measure before raising either.
# MOONMIND_RANK_IMPACT_WEIGHT=0
# MOONMIND_RANK_VERIFIED_WEIGHT=0
# Minimum Atlas cosine score ((1+cos)/2, 0..1) to survive ranking. 0 = disabled.
# Note it also drops metadata-only hits, which have no semantic score.
# MOONMIND_MIN_SEMANTIC_SCORE=0
# Second-stage LLM reranker over the top fused candidates (one extra LLM call).
# MOONMIND_RERANK_ENABLED=false
# MOONMIND_RERANK_CANDIDATES=20
# Query decomposition for multi-part prompts (one call to split, then intent+retrieval
# per sub-query).
# MOONMIND_DECOMPOSE_ENABLED=false
# MOONMIND_DECOMPOSE_MAX_SUBQUERIES=3
# Keyword arm. The collection has no text index, so this is a regex collection scan —
# acceptable only because the collection is small. It was unreachable in the old
# service, so leaving it off keeps retrieval behaviour comparable.
# MOONMIND_KEYWORD_ENABLED=false
# Per-stage retrieval trace (ids/titles only) as an extra field on POST /chat's
# response, behind the password header. Off by default — a measurement tool, not a
# response field to build a frontend on.
# MOONMIND_RETRIEVAL_DEBUG=false

# ---- Document ingestion ----
# summary_for_embedding must hold this many sentences WHEN content_full is empty.
# MOONMIND_SUMMARY_MIN_SENTENCES=3
# MOONMIND_SUMMARY_MAX_SENTENCES=6
# MOONMIND_ENFORCE_SUMMARY_SENTENCE_RANGE=true
